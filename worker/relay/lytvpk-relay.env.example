# Optional environment variables matching the daemon defaults.
RELAY_LISTEN=127.0.0.1:18080
RELAY_ADMIN_LISTEN=127.0.0.1:18081

# Empty by default: request headers cannot override the socket peer identity.
# Trust only explicitly configured loopback proxies that overwrite the client address.
RELAY_TRUSTED_PROXIES=
RELAY_REAL_IP_HEADER=X-Real-IP

RELAY_CLIENT_RATE=50
RELAY_CLIENT_BURST=500
RELAY_GLOBAL_RATE=600
RELAY_GLOBAL_BURST=1000
RELAY_MAX_CLIENTS=20000
RELAY_CLIENT_IDLE_TTL=10m
RELAY_MAX_CONCURRENT=32
RELAY_MAX_CONCURRENT_PER_CLIENT=16
# Bound bursts from existing clients without opening extra upstream connections.
# Set both queue capacities to 0 to disable queuing.
RELAY_MAX_QUEUED=1024
RELAY_MAX_QUEUED_PER_CLIENT=500
RELAY_QUEUE_TIMEOUT=5s
# Body reads, queueing and upstream work share one total budget.
RELAY_REQUEST_TIMEOUT=10s
RELAY_UPSTREAM_TIMEOUT=10s
# Empty RELAY_STATS_FILE explicitly disables persistence.
# SQLite uses the panel's underlying pure-Go driver; no system SQLite is needed.
RELAY_STATS_FILE=/var/lib/lytvpk-relay/stats.sqlite3
RELAY_STATS_FLUSH_INTERVAL=5s
RELAY_MAX_BODY_BYTES=65536
RELAY_MAX_RESPONSE_BYTES=8388608
RELAY_MAX_PARSE_IDS=1000
